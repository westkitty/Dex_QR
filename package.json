{
  "name": "dex-qr",
  "version": "1.0.0",
  "description": "Offline, serverless file transfer over an animated QR fountain-code stream (LT code, robust soliton), with optional AES-GCM encryption. Single-file sender and receiver pages.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node tools/build.mjs",
    "lint": "node tools/lint.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "sweep": "node tests/unit/lt-sweep.mjs 200",
    "trials": "bash tests/e2e/run-drop-trials.sh",
    "all": "make all",
    "video-e2e": "bash tests/e2e/run-video-e2e.sh",
    "bench": "node tests/bench/bench.mjs",
    "browser": "node tests/browser/run.mjs",
    "ux": "node tests/browser/ux.mjs",
    "a11y": "node tests/browser/a11y.mjs",
    "soak": "node tests/browser/soak.mjs",
    "compress": "node tests/browser/compression.mjs",
    "compress-bench": "node tests/bench/compression.mjs",
    "keycheck": "node tests/browser/keycheck.mjs",
    "keycheck-bench": "node tests/bench/keycheck.mjs 100",
    "kdf": "node tests/browser/kdf.mjs",
    "look": "node tests/browser/look.mjs",
    "coach": "node tests/browser/coach.mjs --shots work/coach-shots coach",
    "screens": "node tests/browser/screens.mjs work/screens dexqr",
    "fuzz": "node --expose-gc tests/fuzz/fuzz.mjs --cases 100000 --seed 1 --out results/fuzz_after.json",
    "fuzz-quick": "node --expose-gc tests/fuzz/fuzz.mjs --cases 5000 --seed 7 --long 60",
    "report": "node tools/report.mjs"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "playwright-core": "1.49.1"
  }
}
